{
	"appId": "com.emdia.app",
	"appName": "Em Dia",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"CapacitorUpdater": {
			"autoUpdate": false,
			"appReadyTimeout": 30000
		},
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#1E1B4B",
			"showSpinner": false
		},
		"LocalNotifications": {
			"iconColor": "#1E3A8A"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"FilesystemPlugin",
		"LocalNotificationsPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"CapacitorUpdaterPlugin"
	]
}
